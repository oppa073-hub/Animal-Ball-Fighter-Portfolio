.env
.env.*
*.secret
secrets.json
config.local.json
local.properties

# Addressables / cache
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta
[Aa]ssets/[Ss]treaming[Aa]ssets/aa/

# Packages cache
.vpm/

# External store/downloaded assets
Assets/ExternalAssets/
Assets/ExternalAssets.meta

# Unity Android temporary build files
/.utmp/
*.utmp/

# Unity Android build outputs
/빌드/
*.apk
*.aab
*_BackUpThisFolder_ButDontShipItWithYourGame/
*_BurstDebugInformation_DoNotShip/
# Unity-MCP (com.ivanmurzak.unity.mcp)
# NuGet DLL은 패키지가 도메인 리로드 시 자동 복원함 (NuGetPackageRestorer)
/Assets/Plugins/NuGet/
/Assets/Plugins/NuGet.meta
# 로컬 MCP 서버 주소 (PC별 설정)
/.mcp.json

# 성능 테스트 프레임워크 산출물 (Resources에 있으면 빌드에 포함됨)
Assets/Resources/PerformanceTestRun*.json
Assets/Resources/PerformanceTestRun*.json.meta
